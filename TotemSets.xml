<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

  <Button name="TotemTimers_SetButtonTemplate" frameStrata="HIGH" parent="UIParent" virtual="true" hidden="true" clampedToScreen="true" movable="true" enableMouse="true" inherits="SecureActionButtonTemplate,SecureHandlerEnterLeaveTemplate,ActionButtonTemplate">
    <Size x="36" y="36"/>
    <Anchors>
      <Anchor point="CENTER"/>
    </Anchors>
    <Layers>
      <!-- above the slot background and art of ActionButtonTemplate, like the timer icons -->
      <Layer level="BACKGROUND" textureSubLevel="1">
	    <Texture name="$parentIcon1">
          <Size>
            <AbsDimension x="16" y="16"/>
          </Size>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
              <Offset x="2" y="-2"/>
            </Anchor>
          </Anchors>
        </Texture>
	    <Texture name="$parentIcon2">
          <Size>
            <AbsDimension x="16" y="16"/>
          </Size>
          <Anchors>
            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
              <Offset x="-2" y="-2"/>
            </Anchor>
          </Anchors>
        </Texture>
	    <Texture name="$parentIcon3">
          <Size>
            <AbsDimension x="16" y="16"/>
          </Size>
          <Anchors>
            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
              <Offset x="2" y="2"/>
            </Anchor>
          </Anchors>
        </Texture>
	    <Texture name="$parentIcon4">
          <Size>
            <AbsDimension x="16" y="16"/>
          </Size>
          <Anchors>
            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
              <Offset x="-2" y="2"/>
            </Anchor>
          </Anchors>
        </Texture>
	  </Layer>
    </Layers>
	<Scripts>
		<OnClick>
			TotemTimers.SetButton_OnClick(self, button)
		</OnClick>
	</Scripts>
  </Button>
 
</Ui>

